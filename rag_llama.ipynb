# ============================
# پروژه: RAG با Llama 3.2 و FAISS
# ============================

from langchain_huggingface import HuggingFaceEmbeddings
from langchain_community.vectorstores import FAISS
from langchain_ollama import OllamaLLM
from langchain_classic.chains import RetrievalQA

# ============================
# 1. دیتای اولیه
# ============================
documents = [
    "هوش مصنوعی (AI) شاخه‌ای از علوم کامپیوتر است که به ساخت سیستم‌های هوشمند می‌پردازد.",
    "یادگیری ماشین (ML) زیرمجموعه‌ای از AI است که به کامپیوترها اجازه می‌دهد از داده‌ها یاد بگیرند.",
    "یادگیری عمیق (DL) زیرمجموعه‌ای از ML است که از شبکه‌های عصبی استفاده می‌کند.",
    "NLP شاخه‌ای از AI است که به تعامل کامپیوتر و زبان انسان می‌پردازد.",
    "LLM مدل‌های زبانی بزرگی هستند که روی حجم عظیمی از متن آموزش دیده‌اند."
]

# ============================
# 2. ساخت ایندکس برداری
# ============================
embeddings = HuggingFaceEmbeddings(model_name="sentence-transformers/all-MiniLM-L6-v2")
vectorstore = FAISS.from_texts(documents, embeddings)

# ============================
# 3. بارگذاری Llama 3.2
# ============================
llm = OllamaLLM(model="llama3.2")

# ============================
# 4. ساخت زنجیره‌ی RAG
# ============================
qa_chain = RetrievalQA.from_chain_type(
    llm=llm,
    chain_type="stuff",
    retriever=vectorstore.as_retriever()
)

# ============================
# 5. پرسش و پاسخ
# ============================
query = "یادگیری عمیق چیه؟"
response = qa_chain.invoke(query)

print(f"سوال: {query}")
print(f"جواب: {response['result']}")